# Groq API key (free) for voice note transcription: https://console.groq.com/keys
GROQ_API_KEY=

# Your WhatsApp number(s), comma-separated, digits only (e.g. 923001234567).
# Leave empty to accept messages from anyone (not recommended).
ALLOWED_NUMBERS=

# URL of the opencode server acting as the brain
OPENCODE_URL=http://127.0.0.1:4096

# The bot number in international digits, e.g. 923001234567 (no +/spaces).
# When set, the bot prints an 8-digit pairing code on startup instead of a QR.
PAIR_PHONE_NUMBER=
